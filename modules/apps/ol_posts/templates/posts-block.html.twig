<div>
  <!-- Posts-->
  <div class="posts-list-wrapper">
    <div class="card mb-2 py-2 px-3">
      <div class="row">
        <div class="col-sm-8 pl-3 text-center text-md-left pb-md-0">
          <div class="d-flex align-items-center">
            <img
              alt="group image"
              class="rounded mr-2"
              style="width: 40px; height: 40px; object-fit: cover;"
              src="https://api.dicebear.com/10.x/big-smile/svg?skinColor=C99A7A&seed={{ random() }}&backgroundColor=d4e1df,f9eabf,f6dcd7,f6dcd7,dfd1f2&backgroundColorFill=linear&mouthVariant=kawaii,openedSmile,teethSmile&eyesVariant=cheery,normal&accessoriesVariant=sailormoonCrown,sunglasses"
            />
            <span class="text-muted font-weight-light">
            <i>
              {% set username = user.displayname|length > 30 ? user.displayname|slice(0, 30) ~ '...' : user.displayname %}
              {% trans %}
                Hi {{ username }}, what's happening?
              {% endtrans %}
            </i>
          </span>
          </div>
        </div>
        <div class="col-sm-4 pb-1 pb-md-0 text-center text-md-right">
          <button class="btn btn-success btn-sm" data-toggle="modal" data-target="#addPostModal">
            <i class="lni lni-plus"></i> {{ 'Add Post'|t }}
          </button>
        </div>
      </div>
    </div>
    {% if vars.posts is not empty %}
      {{ vars.posts|raw }}
    {% else %}
      <div class="card ol-card">
        <div class="card-header">
          <p class="text-muted m-3">
            <i class="lni lni-invention"></i> <i> {{ 'Be the first to add a post.'|t }}</i><br />
          </p>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<!-- Modal add post -->
<div class="modal fade bd-example-modal-lg" id="addPostModal" role="dialog" aria-labelledby="addPostModal" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel"><i class="lni lni-plus"></i> {{ 'Post'|t }} </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      {{ vars.post_form }}
    </div>
  </div>
</div>
<!-- / Modal add post  -->
