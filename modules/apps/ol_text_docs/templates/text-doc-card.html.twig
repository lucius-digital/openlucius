<div id="text-doc-edit-form" class="hidden py-3 px-4">
  {{ vars.message_edit_form }}
</div>
<div class="body-wrapper small">
  <div class="card-body">
      <!-- User picture, date and drop down for edit -->
      <div class="media text-muted mt-1  border-bottom">
        <img class="rounded-circle mr-2" src="{{ vars.user_picture }}" alt="user thumbnail" height="35">
        <p class="media-body pb-3 mb-0 small lh-125 border-gray">
          <strong class="d-block text-gray-dark">
            <a href="/user/{{ vars.user_id }}/profile" class="username text-muted">{{ vars.username }}</a>
          </strong>
          <span class="badge badge-light"><i class="fas fa-clock"></i> {{ 'Created'|t }}: {{ vars.created|date("D, d M Y H:i") }} </span>
          <span class="badge badge-light"><i class="fas fa-clock"></i> {{ 'Updated'|t }}: {{ vars.changed|date("D, d M Y H:i") }} </span>
        </p>
        {% if vars.owner == TRUE %}
          <div>
            <div class="dropdown">
              <button class="btn btn-link" type="button" id="ol-drop2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="lni lni-line-dotted"></i>
              </button>
              <div class="dropdown-menu dropdown-menu-right" aria-labelledby="ol-drop2">
                <a class="dropdown-item" href="#" id="edit-text-doc">{{ 'Edit'|t }} </a>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
      <!-- Body -->
      <div class="px-md-4 pt-md-3" id="text-doc-body">
        {{ vars.body|raw }}
      </div>
    </div>

  {# Files #}
  {% if vars.files %}
  <div class="px-md-4 pb-md-2 border-top-dashed">
    <h5 class="text-black-50 mb-3 mt-2">{{ 'Attachments'|t }}</h5>
    <div class="files_wrapper">
      {{ vars.files|raw }}
    </div>
  </div>
  {% endif %}

  {# Links #}
  <div class="px-md-4 pb-md-2 border-top-dashed">
    <h5 class="text-black-50 mb-3 mt-2">
      {{ 'Links'|t }}
      <button id="show-weblink-form" class="btn btn-sm text-muted small p-0 mb-1">
        <i class="lni lni-circle-plus"></i>
      </button>
    </h5>
    <div id="linked-items-wrapper">
      {{ vars.weblinks_html|raw }}
    </div>
    <div id="weblink-form-wrapper" class="hidden">
      {{ vars.weblink_form }}
      {{ vars.weblink_delete_form }}
    </div>
  </div>

  <!-- Footer -->
  <div class="card-footer">
    <div class="">
      {{ vars.like_button }}
    </div>
    <div class="mt-2">
      <a id="comment_list"></a>
      {% if vars.comment_count == 1 %}
        {% set var_comment = 'Comment' %}
        <a href="{{ vars.link }}#comment_list" class="card-link btn btn-light px-5 text-muted btn-sm"><i class="fa fa-comment"></i> {{ vars.comment_count }} {{ var_comment|t }}</a>
      {% elseif vars.comment_count == 0 %}
        {% set var_comment = 'Be the first to comment' %}
        <a href="{{ vars.link }}#comment_list" class="card-link btn btn-light px-5 text-muted btn-sm"><i class="fa fa-comment"></i> {{ var_comment|t }}</a>
      {% else %}
        {% set var_comment = 'Comments' %}
        <a href="{{ vars.link }}#comment_list" class="card-link btn btn-light px-5 text-muted btn-sm"><i class="fa fa-comment"></i> {{ vars.comment_count }} {{ var_comment|t }} </a>
      {% endif %}
    </div>
  </div>
</div>
