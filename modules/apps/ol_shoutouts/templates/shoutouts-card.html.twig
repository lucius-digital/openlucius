{#<div class="col-lg-10 offset-lg-1">#}
<div>
<div class="card shadow-sm mb-3">
  <a id="shoutout_id_{{ vars.id }}"></a>
  <div class="card-header pb-0 bg-white border-0">
      <div class="row">
        <div class="col-4">
          <div class="media text-muted">
            <img class="rounded-circle mr-2" src="{{ vars.user_picture }}" alt="user thumbnail" height="35">
            <p class="media-body pb-3 mb-0 small lh-125 border-gray">
              <strong class="d-block text-gray-dark">
                <a href="/user/{{ vars.user_id }}/profile" class="username text-muted">{{ vars.username }}</a>
              </strong>
              <span class="text-muted small">{{ vars.created }}</span>
            </p>
          </div>
        </div>
        <div class="col-2 mr-2">
          <h5><i class="lni lni-emoji-happy text-secondary mr-2"></i> <i class="lni lni-angle-double-right text-secondary"></i> </h5>
        </div>
        <div class="col-4">
          <div class="media text-muted">
            <img class="rounded-circle mr-2" src="{{ vars.receiver_user_picture }}" alt="user thumbnail" height="35">
            <p class="media-body pb-3 mb-0 small lh-125 border-gray">
              <strong class="d-block text-gray-dark">
                <a href="/user/{{ vars.receiver_uid }}/profile" class="username text-muted">{{ vars.receiver_user_name }}</a>
              </strong>
            </p>
            {% if vars.owner == TRUE %}
              <span class="float-right">
                <span class="dropdown">
                  <button class="btn btn-link" type="button" id="ol-drop2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="lni lni-line-dotted"></i>
                  </button>
                  <span class="dropdown-menu dropdown-menu-right" aria-labelledby="ol-drop2">
                    <a class="dropdown-item" href="#" data-toggle="modal" data-target="#editMessageModal_{{ vars.id }}">{{ 'Edit'|t }}</a>
                  </span>
                </span>
              </span>
            {% endif %}
          </div>
        </div>
      </div>
  </div>
  <div class="card-body pt-0 pb-0">
    {{ vars.body|raw }}
  </div>
  <div class="card-footer">
    <div class="like-wrapper">
      {{ vars.like_button }}
    </div>
  </div>  <!-- / Footer -->
</div>
<!-- / Shoutout card-->

{% if vars.owner == TRUE %}
  <!-- Edit Modal -->
  <div class="modal fade bd-example-modal-lg" id="editMessageModal_{{ vars.id }}" role="dialog" aria-labelledby="editMessageLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="exampleModalLabel"><i class="fas fa-edit"></i> {{ 'Edit shoutout'|t }}  </h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
          {{ vars.shoutout_edit_form }}
      </div>
    </div>
  </div>
  <!-- / Modal  -->
{% endif %}
</div>
